# cni-bootstrap defaults for the kube-ovn-v2 chart. Override per-key via
# helm_set or with later helm_values documents.
central:
  resources:
    requests:
      cpu: "1"
      memory: "768Mi"
agent:
  resources:
    requests:
      memory: "256Mi"
    limits:
      memory: "256Mi"
ovsOvn:
  resources:
    requests:
      memory: "512Mi"
    limits:
      memory: "512Mi"
  # Replace OVS on one node at a time without requiring CPU for a second pod.
  updateStrategy:
    type: RollingUpdate
    maxSurge: 0
    maxUnavailable: 1
%{ if service_cidr != "" ~}
networking:
  services:
    cidr:
      v4: "${service_cidr}"
%{ endif ~}
pinger:
  targets:
    externalAddresses:
      v4: "8.8.8.8"
    externalDomain:
      v4: "google.com."
%{ if master_label_key != "" ~}
masterNodesLabels:
  "${master_label_key}": "${master_label_value}"
%{ endif ~}
controller:
  resources:
    requests:
      memory: "1536Mi"
    limits:
      memory: "1536Mi"
%{ if master_label_key != "" ~}
  # Pin kube-ovn-controller onto the dedicated CNI node, alongside ovn-central
  # (pinned there by the chart via masterNodesLabels).
  nodeAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      - matchExpressions:
          - key: "${master_label_key}"
%{ if master_label_value != "" ~}
            operator: In
            values: ["${master_label_value}"]
%{ else ~}
            operator: Exists
%{ endif ~}
%{ endif ~}
