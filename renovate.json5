{
  extends: [
    'config:best-practices',
  ],
  dependencyDashboard: true,
  gitIgnoredAuthors: [
    '245757523+pt-release-please[bot]@users.noreply.github.com',
  ],
  // Keeps the .pre-commit-config.yaml `rev:` pins current. Not enabled by config:best-practices,
  // which is why pre-commit-terraform had drifted many minor versions behind.
  'pre-commit': {
    enabled: true,
  },
  customManagers: [
    {
      // Helm chart versions in the cni-bootstrap defaults.
      customType: 'regex',
      managerFilePatterns: [
        '/^modules/cni-bootstrap/main\\.tf$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+registryUrl=(?<registryUrl>\\S+))?[^\\n]*\\n\\s*version\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
      versioningTemplate: 'semver',
    },
    {
      // CI tool versions that the built-in github-actions manager cannot see: `with:` inputs
      // (setup-trivy's version, setup-tflint's tflint_version) and `env:` vars interpolated into
      // download URLs (hcledit, terraform-docs). Only annotated lines are matched, so
      // terraform_version stays pinned to the required_version floor by hand.
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?[^\\n]*\\n\\s*[\\w-]+:\\s*["\']?(?<currentValue>[^"\'\\s]+)["\']?',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
  ],
  packageRules: [
    {
      description: 'Group terraform-aws-modules IAM updates together',
      matchDatasources: [
        'terraform-module',
      ],
      groupName: 'terraform-aws-modules/iam',
      matchPackageNames: [
        '/terraform-aws-modules/iam/',
      ],
    },
    {
      description: 'Group terraform-aws-modules EKS updates together',
      matchDatasources: [
        'terraform-module',
      ],
      groupName: 'terraform-aws-modules/eks',
      matchPackageNames: [
        '/terraform-aws-modules/eks/',
      ],
    },
  ],
}
